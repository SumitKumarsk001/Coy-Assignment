{
  "name": "coy-discover-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "express": "4.21.2",
    "framer-motion": "11.11.17",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
